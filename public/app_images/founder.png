<svg width="400" height="400" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="100%" height="100%" rx="32" fill="#F8FAFC" />
  <circle cx="200" cy="150" r="80" fill="#0E3589" opacity="0.1" />
  
  <!-- Stylized Elegant Educator Avatar -->
  <circle cx="200" cy="140" r="55" fill="#FDE68A" />
  <!-- Hair -->
  <path d="M145 130 C145 75 255 75 255 130 C255 160 240 180 240 180 C240 180 225 150 200 150 C175 150 160 180 160 180 C160 180 145 160 145 130 Z" fill="#1E293B" />
  <!-- Glasses -->
  <circle cx="180" cy="140" r="14" fill="none" stroke="#F46E20" stroke-width="3" />
  <circle cx="220" cy="140" r="14" fill="none" stroke="#F46E20" stroke-width="3" />
  <line x1="194" y1="140" x2="206" y2="140" stroke="#F46E20" stroke-width="3" />
  <!-- Warm Smile -->
  <path d="M185 165 Q200 178 215 165" stroke="#92400E" stroke-width="3" fill="none" stroke-linecap="round" />
  <!-- Saree / Formal Attire -->
  <path d="M110 320 C110 240 150 210 200 210 C250 210 290 240 290 320 Z" fill="#0E3589" />
  <path d="M160 210 Q200 260 240 320" stroke="#F46E20" stroke-width="12" fill="none" />
  <polygon points="190,260 200,240 210,260" fill="#FBBF24" />

  <!-- Badge -->
  <rect x="70" y="320" width="260" height="50" rx="25" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="2" />
  <text x="200" y="344" text-anchor="middle" font-family="'Outfit', sans-serif" font-weight="bold" font-size="15" fill="#0E3589">Mrs. Deepthy Rock</text>
  <text x="200" y="360" text-anchor="middle" font-family="'Outfit', sans-serif" font-weight="600" font-size="11" fill="#F46E20">Founder &amp; Principal Coach</text>
</svg>
