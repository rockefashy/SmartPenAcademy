<svg width="600" height="400" xmlns="http://www.w3.org/2000/svg">
  <rect width="100%" height="100%" fill="#FBFDFF" />
  <!-- Crisp Notebook lines -->
  <line x1="40" y1="80" x2="560" y2="80" stroke="#fca5a5" stroke-width="1.5" />
  <line x1="40" y1="120" x2="560" y2="120" stroke="#93c5fd" stroke-width="1" />
  <line x1="40" y1="160" x2="560" y2="160" stroke="#93c5fd" stroke-width="1" />
  <line x1="40" y1="200" x2="560" y2="200" stroke="#fca5a5" stroke-width="1.5" />
  
  <line x1="40" y1="260" x2="560" y2="260" stroke="#fca5a5" stroke-width="1.5" />
  <line x1="40" y1="300" x2="560" y2="300" stroke="#93c5fd" stroke-width="1" />
  <line x1="40" y1="340" x2="560" y2="340" stroke="#93c5fd" stroke-width="1" />
  <line x1="40" y1="380" x2="560" y2="380" stroke="#fca5a5" stroke-width="1.5" />

  <text x="50" y="40" font-family="sans-serif" font-size="14" font-weight="bold" fill="#059669">TRANSFORMED SAMPLE: CLASS 10 (AFTER)</text>
  
  <!-- Beautiful, elegant cursive handwriting sample -->
  <g transform="translate(50, 160)">
    <text font-family="'Brush Script MT', 'Caveat', cursive, sans-serif" font-size="44" font-weight="600" fill="#0E3589" letter-spacing="1.5">The quick brown fox jumps</text>
  </g>
  
  <g transform="translate(50, 340)">
    <text font-family="'Brush Script MT', 'Caveat', cursive, sans-serif" font-size="44" font-weight="600" fill="#0E3589" letter-spacing="1.5">over the lazy dog with poise.</text>
  </g>
  
  <!-- Green checkmarks & star badges -->
  <g transform="translate(480, 25)">
    <circle cx="20" cy="20" r="16" fill="#10B981" />
    <path d="M12 20 L17 25 L28 14" stroke="#ffffff" stroke-width="3" fill="none" stroke-linecap="round" />
  </g>
  <text x="280" y="235" font-family="sans-serif" font-size="12" fill="#059669" font-weight="bold">✓ Perfect 65° Slant &amp; Baseline Uniformity</text>
</svg>
