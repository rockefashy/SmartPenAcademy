<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 220" width="100%" height="100%">
  <!-- Definitions & Google Fonts for pixel-perfect font rendering -->
  <defs>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@800;900&amp;family=Caveat:wght@700&amp;display=swap');
      .navy-fill { fill: #0B2568; }
      .orange-fill { fill: #F47216; }
      .blue-fill { fill: #0084F4; }
    </style>
  </defs>

  <!-- Left: Crest Emblem (Mortarboard Cap + Orange Tassel + Pencil Core + Joyful Kids + Star) -->
  <g transform="translate(110, 110)">
    <!-- Left Blue Joyful Figure -->
    <g>
      <circle cx="-64" cy="-14" r="12" fill="#0084F4" />
      <!-- Body swoosh -->
      <path d="M-78 -4 C-75 28 -46 54 -16 60 C-34 56 -58 38 -70 -2 Z" fill="#0084F4" />
      <!-- Left arm swoosh up -->
      <path d="M-78 -4 C-86 -24 -78 -40 -68 -50 C-74 -34 -72 -18 -64 -5 Z" fill="#0084F4" />
    </g>

    <!-- Right Orange Joyful Figure -->
    <g>
      <circle cx="64" cy="-6" r="12" fill="#F47216" />
      <!-- Body swoosh -->
      <path d="M78 8 C75 40 46 58 16 60 C34 56 58 40 70 10 Z" fill="#F47216" />
      <!-- Right arm swoosh up -->
      <path d="M78 8 C86 -14 80 -30 70 -40 C75 -24 72 -8 66 6 Z" fill="#F47216" />
      <!-- Star above orange figure head -->
      <polygon points="66,-64 69,-55 78,-55 70,-49 73,-40 66,-46 58,-40 61,-49 54,-55 63,-55" fill="#F47216" />
    </g>

    <!-- Center Pencil Core -->
    <!-- Pencil Body -->
    <rect x="-18" y="-30" width="36" height="60" fill="#0B2568" />
    <!-- Pencil Center Shadow Highlight -->
    <rect x="-5" y="-30" width="10" height="60" fill="#183E9C" />
    
    <!-- Pencil Sharpened Cone & Point -->
    <path d="M-18 30 L18 30 L0 74 Z" fill="#0B2568" />
    <!-- Scalloped wood cut (white) -->
    <path d="M-18 30 C-12 36 -6 37 0 32 C6 37 12 36 18 30 L0 66 Z" fill="#FFFFFF" />
    <!-- Pencil Lead Tip -->
    <path d="M-5 56 L5 56 L0 74 Z" fill="#0B2568" />

    <!-- Graduation Cap / Mortarboard on top of pencil -->
    <!-- Skull base rim -->
    <path d="M-20 -34 C-20 -40 20 -40 20 -34 L20 -28 C20 -22 -20 -22 -20 -28 Z" fill="#071948" />
    <!-- Diamond cap top -->
    <polygon points="0,-76 58,-56 0,-34 -58,-56" fill="#0B2568" stroke="#071948" stroke-width="1.5" />
    <!-- Center button on cap -->
    <circle cx="0" cy="-56" r="3.5" fill="#F47216" />
    <!-- Orange tassel -->
    <path d="M0 -56 Q36 -46 34 -20" fill="none" stroke="#F47216" stroke-width="3.5" stroke-linecap="round" />
    <!-- Tassel brush -->
    <polygon points="30,-20 38,-20 34,-5" fill="#F47216" />
  </g>

  <!-- Right: Typography Lockup aligned horizontally -->
  <g transform="translate(235, 0)">
    <!-- 1. "SmartPen" Text -->
    <g transform="translate(0, 84)">
      <text font-family="'Montserrat', -apple-system, sans-serif" font-weight="900" font-size="74" letter-spacing="-1.5">
        <tspan fill="#0B2568">Smart</tspan><tspan fill="#F47216">Pen</tspan>
      </text>
    </g>

    <!-- 2. "— ACADEMY —" Divider Bar -->
    <g transform="translate(0, 134)">
      <!-- Left Blue Horizontal Bar -->
      <line x1="2" y1="-8" x2="80" y2="-8" stroke="#0084F4" stroke-width="5" stroke-linecap="round" />
      <!-- ACADEMY Text -->
      <text x="210" y="0" text-anchor="middle" fill="#0B2568" font-family="'Montserrat', sans-serif" font-weight="900" font-size="28" letter-spacing="9">
        ACADEMY
      </text>
      <!-- Right Orange Horizontal Bar -->
      <line x1="340" y1="-8" x2="418" y2="-8" stroke="#F47216" stroke-width="5" stroke-linecap="round" />
    </g>

    <!-- 3. "Neat Writing. Sharp Minds!" Tagline -->
    <g transform="translate(0, 196)">
      <text x="210" text-anchor="middle" fill="#0B2568" font-family="'Caveat', cursive, sans-serif" font-weight="700" font-style="italic" font-size="46" letter-spacing="0.5">
        Neat Writing. Sharp Minds!
      </text>
    </g>
  </g>
</svg>
